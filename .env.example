# Copy this file to .env.local for local development.
# In Vercel/Netlify, set these under Project Settings → Environment Variables instead —
# never commit real values.

# Used by the AI assist panel for Gemini model calls.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Base URL for canonical SEO, OpenGraph images, and sitemap generation.
NEXT_PUBLIC_APP_URL=https://contentforge.app
